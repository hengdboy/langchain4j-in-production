# ============================================================
# LangChain4j Tutorial .gitignore
# 覆盖 Maven / Java / Spring Boot / Node.js / IDE / OS
# ============================================================

# ----- Maven -----
target/
**/target/
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.tgz

# 但保留项目自带的可执行 JAR（mcp-server fat jar 等）
!smart-doc-assistant/mcp-server/*.jar

# Maven Wrapper 缓存
.mvn/wrapper/maven-wrapper.jar

# ----- Java -----
*.class
*.log
hs_err_pid*
replay_pid*

# ----- Spring Boot -----
# 本地覆盖配置（含密钥），不提交
application-local.yml
application-local.yaml
application-local.properties

# 但保留示例与默认配置
!application.yml
!application-dev.yml
!application-prod.yml

# ----- Node.js（mcp-server/） -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 但保留 package-lock.json / yarn.lock（团队一致）
!package-lock.json
!yarn.lock

# ----- 环境变量 / 密钥 -----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.yml

# ----- IDE -----
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.factorypath
.apt_generated/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# NetBeans
nbproject/
nb-build/
nb-dist/

# ----- 操作系统 -----
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.Trash-*

# ----- 项目特定 -----
# Workbuddy / Qwen 等 AI 工具缓存
.workbuddy/
.qwen/
.claude/

# 教程运行时产物（向量库快照、运行日志、临时文件）
*.pid
*.seed
*.pid.lock

# Spring Boot Actuator 快照
dump.rpt
hsperfdata*

# IDE / 工具临时文件
*.swp
*.swo
*~
.cache/
.tmp/

# 截图与录屏（如果用）
*.png.bak
*.mp4.bak

# 多媒体临时文件
*.tmp.mp4
*.tmp.png